{
  "schema_version": 1,
  "name": "cifar10-v3-trusted-anchor-or-20260821",
  "description": "CIFAR-10 five-method experiment with the third-revision trusted-anchor SVD detector and an explicit, shared attack schedule.",
  "parameters": {
    "dataset": "cifar10",
    "download": true,
    "data_dir": "data/cifar10",
    "output_dir": "outputs/cifar10_v3_trusted_anchor_or_20260821",

    "methods": [
      "sm9rrs",
      "vert",
      "fedavg",
      "krum",
      "ding13"
    ],

    "ratios": [
      0.0,
      0.2,
      0.4,
      0.6,
      0.8
    ],

    "partitions": [
      "iid",
      "dirichlet"
    ],

    "dirichlet_alpha": 0.5,
    "client_counts": [
      200
    ],

    "rounds": 50,
    "train_samples": 50000,
    "test_samples": 10000,
    "local_epochs": 1,
    "batch_size": 32,
    "lr": 0.05,
    "lr_decay": 0.99,
    "target_error": 0.12,

    "attack": "alternating_minimization",
    "attack_boost": 7.5,
    "attack_epochs": 1,
    "attack_stealth_steps": 8,
    "attack_distance_weight": 0.0001,
    "attack_source_label": 5,
    "attack_target_label": 7,
    "attack_target_count": 128,
    "attack_start_round": 12,

    "K": 10,
    "detector_subspace_dim": 2,
    "detector_gap_threshold": 0.1,
    "detector_adjacent_threshold": 3.0,
    "detector_anchor_threshold": 3.0,
    "detector_drift_memory": 0.9,
    "detector_drift_allowance": 1.0,
    "detector_drift_threshold": 5.0,
    "detector_decision_rule": "any",
    "suspicion_remove_after": 3,
    "suspicion_count_max": 3,
    "suspicion_penalty_factor": 0.01,
    "suspicion_recovery_factor": 10.0,

    "vert_history_window": 10,
    "vert_projection_dim": 128,
    "vert_predict_epochs": 5,
    "vert_predict_lr": 0.001,
    "vert_top_k": 0,
    "vert_use_ratio_prior": false,

    "crypto_mode": "sm9",
    "dkg_threshold": 2,
    "dkg_nodes": 3,
    "sm9_workers": "auto",

    "compute_backend": "auto",
    "device": "auto",
    "jobs": "auto",

    "eval_interval": 1,
    "early_stop": false,
    "resume": true,
    "visualizations": true,
    "progress": true,
    "progress_mode": "live",
    "checkpoint_interval": 0,
    "seed": 42
  }
}
