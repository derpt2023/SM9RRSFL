{
  "schema_version": 1,
  "name": "mnist-v3-auto-calibrated",
  "description": "MNIST six-method study with disjoint calibration/main malicious ratios, bounded automatic Ours policy calibration, learned Score weights, and the previously omitted FedREDefense teacher learning rate.",
  "parameters": {
    "dataset": "mnist",
    "download": true,
    "data_dir": "data/mnist",
    "output_dir": "outputs/mnist_v3_20260825",

    "methods": [
      "sm9rrs",
      "vert",
      "fedredefense",
      "krum",
      "ding13",
      "fedavg"
    ],

    "ratio_range": [0.0, 0.8, 5],

    "partitions": [
      "iid",
      "dirichlet"
    ],

    "dirichlet_alpha": 0.5,
    "client_counts": [
      100
    ],

    "rounds": 50,
    "train_samples": 50000,
    "test_samples": 10000,
    "local_epochs": 1,
    "batch_size": 32,
    "lr": 0.05,
    "lr_decay": 0.99,
    "target_error": 0.12,

    "attack": "alternating_minimization",
    "attack_boost": 15.0,
    "attack_epochs": 1,
    "attack_stealth_steps": 1,
    "attack_distance_weight": 0.0001,
    "attack_source_label": 5,
    "attack_target_label": 7,
    "attack_target_count": 128,
    "attack_start_round": 12,

    "K": 7,
    "ours_parameter_mode": "auto",
    "calibration_candidate_budget": 12,
    "ASR": 0.2,
    "calibration_min_three_round_recall": 0.8,
    "calibration_max_attack_false_positive_rate": 0.05,
    "calibration_min_round_completion_rate": 1.0,
    "calibration_max_nonfinite_updates": 0,

    "vert_history_window": 7,
    "vert_projection_dim": 128,
    "vert_predict_epochs": 5,
    "vert_predict_lr": 0.001,
    "vert_top_k": 0,
    "vert_use_ratio_prior": false,

    "fedre_threshold": 0.6,
    "fedre_initial_iterations": 800,
    "fedre_max_iterations": 2000,
    "fedre_synthetic_steps": 5,
    "fedre_images_per_class": 1,
    "fedre_image_lr": 0.5,
    "fedre_label_lr": 0.2,
    "fedre_teacher_lr": 5.0,
    "fedre_teacher_lr_lr": 0.000005,

    "crypto_mode": "sm9",
    "dkg_threshold": 2,
    "dkg_nodes": 3,
    "sm9_workers": "auto",

    "compute_backend": "auto",
    "device": "auto",
    "jobs": "auto",

    "eval_interval": 1,
    "early_stop": false,
    "resume": true,
    "visualizations": true,
    "progress": true,
    "progress_mode": "live",
    "checkpoint_interval": 0,
    "seed": 42
  }
}
