{
  "schema_version": 3,
  "name": "CIFAR-10 Fair Tuning v12 (Correct)",
  "description": "Fair tuning for CIFAR-10 following MNIST v7 methodology: tune sm9rrs, vert, alignins; fixed params for krum, ding13, fedavg",
  "shared_parameters": {
    "dataset": "cifar10",
    "data_dir": "data/cifar10",
    "download": true,
    "output_dir": "outputs/cifar10_v12_fair_tuning",
    "methods": [
      "sm9rrs",
      "vert",
      "alignins",
      "krum",
      "ding13",
      "fedavg"
    ],
    "ratio_range": [0.0, 0.8, 5],
    "client_counts": [100],
    "partitions": ["iid"],
    "rounds": 50,
    "train_samples": 50000,
    "test_samples": 10000,
    "target_error": 0.12,
    "local_epochs": 1,
    "batch_size": 50,
    "lr": 0.05,
    "lr_decay": 0.99,
    "compute_backend": "torch",
    "device": "cuda",
    "jobs": "auto",
    "attack": "alternating_minimization",
    "attack_boost": 20.0,
    "attack_epochs": 1,
    "attack_stealth_steps": 1,
    "attack_distance_weight": 0.0001,
    "attack_source_label": 5,
    "attack_target_label": 7,
    "attack_target_count": 200,
    "attack_start_round": 25,
    "K": 20,
    "ours_parameter_mode": "fixed",
    "detector_subspace_dim": 3,
    "detector_normal_clusters": 2,
    "calibration_candidate_budget": 12,
    "calibration_min_round_completion_rate": 1.0,
    "calibration_max_nonfinite_updates": 0,
    "crypto_mode": "simulated",
    "early_stop": false,
    "eval_interval": 1,
    "resume": true,
    "visualizations": false,
    "progress": true,
    "progress_mode": "log",
    "checkpoint_interval": 0,
    "seed": 42
  },
  "tuning": {
    "algorithm": "grid",
    "validation_fraction": 0.05,
    "split_seed": 20261013,
    "validation_seeds": [71, 72, 73],
    "final_seeds": [241, 242, 243],
    "trials_per_tunable_method": 20,
    "max_clean_accuracy_drop": 0.05,
    "performance_target": {
      "accuracy_gap": 0.02,
      "asr_gap": 0.01,
      "max_asr": 0.10,
      "max_peak_asr": 0.25,
      "tail_rounds": 10
    },
    "run_final_evaluation": true,
    "final_jobs": "auto",
    "objective": "auto",
    "method_spaces": {
      "sm9rrs": {
        "attack_boost": [20.0, 21.0, 22.0, 23.0, 24.0],
        "detector_distance_threshold": [1.7, 1.9, 2.1, 2.3],
        "detector_subspace_dim": [3]
      },
      "vert": {
        "vert_history_window": [5, 7, 10],
        "vert_predict_epochs": [5, 20],
        "vert_predict_lr": [0.0005, 0.001]
      },
      "alignins": {
        "alignins_sparsity": [0.1, 0.3, 0.5],
        "alignins_tda_radius": [0.5, 1.0],
        "alignins_mpsa_radius": [0.5, 1.0]
      },
      "krum": {},
      "ding13": {},
      "fedavg": {}
    }
  }
}
