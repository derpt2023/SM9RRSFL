{
  "schema_version": 2,
  "name": "CIFAR-10 sm9rrs Quick Grid Search",
  "description": "Fast grid search focusing on attack_boost and threshold only",
  "base": {
    "dataset": "cifar10",
    "data_dir": "data/cifar10",
    "download": true,
    "output_dir": "outputs/cifar10_sm9rrs_quick_grid",
    "methods": ["sm9rrs"],
    "rounds": 50,
    "train_samples": 50000,
    "test_samples": 10000,
    "target_error": 0.12,
    "local_epochs": 1,
    "batch_size": 50,
    "lr": 0.05,
    "lr_decay": 0.99,
    "compute_backend": "torch",
    "device": "cuda",
    "jobs": "auto",
    "attack": "alternating_minimization",
    "attack_epochs": 1,
    "attack_stealth_steps": 1,
    "attack_distance_weight": 0.0001,
    "attack_source_label": 5,
    "attack_target_label": 7,
    "attack_target_count": 200,
    "attack_start_round": 25,
    "K": 20,
    "ours_parameter_mode": "fixed",
    "detector_subspace_dim": 3,
    "detector_normal_clusters": 2,
    "crypto_mode": "simulated",
    "early_stop": false,
    "eval_interval": 1,
    "checkpoint_interval": 50,
    "visualizations": false,
    "seed": 42
  },
  "experiments": [
    {"attack_boost": 20, "detector_distance_threshold": 1.7, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 20, "detector_distance_threshold": 1.9, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 20, "detector_distance_threshold": 2.1, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 20, "detector_distance_threshold": 2.3, "partition": "iid", "malicious_ratio": 0.2},

    {"attack_boost": 21, "detector_distance_threshold": 1.7, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 21, "detector_distance_threshold": 1.9, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 21, "detector_distance_threshold": 2.1, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 21, "detector_distance_threshold": 2.3, "partition": "iid", "malicious_ratio": 0.2},

    {"attack_boost": 22, "detector_distance_threshold": 1.7, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 22, "detector_distance_threshold": 1.9, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 22, "detector_distance_threshold": 2.1, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 22, "detector_distance_threshold": 2.3, "partition": "iid", "malicious_ratio": 0.2},

    {"attack_boost": 23, "detector_distance_threshold": 1.7, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 23, "detector_distance_threshold": 1.9, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 23, "detector_distance_threshold": 2.1, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 23, "detector_distance_threshold": 2.3, "partition": "iid", "malicious_ratio": 0.2},

    {"attack_boost": 24, "detector_distance_threshold": 1.7, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 24, "detector_distance_threshold": 1.9, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 24, "detector_distance_threshold": 2.1, "partition": "iid", "malicious_ratio": 0.2},
    {"attack_boost": 24, "detector_distance_threshold": 2.3, "partition": "iid", "malicious_ratio": 0.2}
  ]
