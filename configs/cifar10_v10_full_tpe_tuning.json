{
  "schema_version": 3,
  "name": "CIFAR-10 Full TPE Tuning - All Methods",
  "description": "Complete hyperparameter optimization for fair comparison targeting top-tier publication",
  "tuning": {
    "enabled": true,
    "framework": "optuna",
    "sampler": "TPESampler",
    "trials_per_method": 30,
    "calibration_ratios": [0.2],
    "calibration_partitions": ["iid"],
    "calibration_rounds": 30,
    "validation_rounds": 50,
    "selection_metrics": {
      "primary": "attack_success_rate",
      "secondary": "accuracy_drop",
      "weights": {"asr": 0.6, "accuracy": 0.3, "stability": 0.1}
    }
  },
  "parameters": {
    "dataset": "cifar10",
    "data_dir": "data/cifar10",
    "output_dir": "outputs/cifar10_v10_full_tpe_tuning",
    "methods": ["sm9rrs", "vert", "alignins"],
    "ratios": [0.0, 0.2, 0.4, 0.6, 0.8],
    "partitions": ["iid", "dirichlet"],
    "dirichlet_alpha": 0.5,
    "num_clients": 100,
    "rounds": 50,
    "local_epochs": 1,
    "batch_size": 50,
    "lr": 0.05,
    "lr_decay": 0.99,
    "attack": "alternating_minimization",
    "attack_boost": {"type": "suggest_float", "low": 15.0, "high": 30.0},
    "attack_epochs": 1,
    "attack_source_label": 5,
    "attack_target_label": 7,
    "attack_target_count": 200,
    "attack_start_round": 12,
    "detector_window": 10,
    "detector_subspace_dim": {"type": "suggest_int", "low": 2, "high": 5},
    "detector_normal_clusters": 2,
    "detector_distance_threshold": {"type": "suggest_float", "low": 1.5, "high": 3.0},
    "detector_reject_threshold": {"type": "suggest_float", "low": 3.0, "high": 6.0},
    "detector_drift_memory": {"type": "suggest_float", "low": 0.7, "high": 0.95},
    "detector_drift_allowance": {"type": "suggest_float", "low": 1.5, "high": 3.0},
    "detector_drift_threshold": {"type": "suggest_float", "low": 5.0, "high": 8.0},
    "detector_history_confirm": {"type": "suggest_int", "low": 2, "high": 4},
    "detector_history_threshold": {"type": "suggest_float", "low": 1.3, "high": 2.0},
    "detector_recovery_confirm": 2,
    "detector_reference_budget": {"type": "suggest_float", "low": 2.5, "high": 4.0},
    "detector_clip_factor": {"type": "suggest_float", "low": 1.5, "high": 3.0},
    "detector_weight_cap": {"type": "suggest_float", "low": 1.5, "high": 3.0},
    "suspicion_penalty_factor": {"type": "suggest_float", "low": 0.3, "high": 0.7},
    "suspicion_recovery_factor": 1.25,
    "suspicion_remove_after": 3,
    "vert_history_window": {"type": "suggest_int", "low": 3, "high": 10},
    "vert_predict_epochs": {"type": "suggest_int", "low": 10, "high": 30},
    "vert_predict_lr": {"type": "suggest_loguniform", "low": 0.0001, "high": 0.002},
    "alignins_mpsa_radius": {"type": "suggest_float", "low": 0.5, "high": 2.0},
    "alignins_sparsity": {"type": "suggest_float", "low": 0.05, "high": 0.2},
    "alignins_tda_radius": {"type": "suggest_float", "low": 0.5, "high": 2.0},
    "crypto_mode": "simulated",
    "compute_backend": "torch",
    "device": "cuda",
    "early_stop": false,
    "eval_interval": 1,
