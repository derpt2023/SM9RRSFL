{
  "schema_version": 3,
  "name": "CIFAR-10 - VERT optimized test (MNIST parameters)",
  "description": "Test VERT with MNIST optimal parameters to ensure it doesn't underperform",
  "parameters": {
    "dataset": "cifar10",
    "data_dir": "data/cifar10",
    "download": true,
    "output_dir": "outputs/cifar10_vert_optimized_test",
    "methods": ["vert"],
    "ratios": [0.2, 0.4],
    "partitions": ["iid", "dirichlet"],
    "dirichlet_alpha": 0.5,
    "num_clients": 100,
    "rounds": 50,
    "local_epochs": 1,
    "batch_size": 50,
    "lr": 0.05,
    "lr_decay": 0.99,
    "attack": "alternating_minimization",
    "attack_boost": 20.0,
    "attack_epochs": 1,
    "attack_source_label": 5,
    "attack_target_label": 7,
    "attack_target_count": 200,
    "attack_start_round": 12,
    "vert_history_window": 5,
    "vert_predict_epochs": 20,
    "vert_predict_lr": 0.0005,
    "crypto_mode": "simulated",
    "compute_backend": "torch",
    "device": "cuda",
    "early_stop": false,
    "eval_interval": 1,
    "seed": 2026101302
  }
}
