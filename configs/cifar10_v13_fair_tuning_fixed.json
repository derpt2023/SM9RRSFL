{
  "schema_version": 3,
  "name": "cifar10_v13_fair_tuning_fixed",
  "description": "CIFAR-10 公平调优 v13 - 基于今天的测试结果，正确设置共享参数",

  "shared_parameters": {
    "dataset": "cifar10",
    "data_dir": "data/cifar10",
    "download": true,
    "output_dir": "outputs/cifar10_v13_fair_tuning",

    "num_clients": 10,
    "rounds": 150,
    "local_epochs": 1,
    "batch_size": 50,
    "lr": 0.01,
    "lr_decay": 0.998,

    "partition": "iid",
    "train_samples": 5000,
    "test_samples": 1000,

    "attack": "alternating_minimization",
    "attack_boost": 20.0,
    "attack_epochs": 1,
    "attack_stealth_steps": 1,
    "attack_distance_weight": 0.0001,
    "attack_source_label": 3,
    "attack_target_label": 5,
    "attack_start_round": 25,

    "K": 20,
    "ours_parameter_mode": "fixed",

    "detector_subspace_dim": 3,
    "detector_normal_clusters": 2,
    "detector_reject_threshold": 5.0,
    "detector_drift_memory": 0.8,
    "detector_drift_allowance": 2.0,
    "detector_drift_threshold": 6.0,
    "detector_history_confirm": 2,
    "detector_history_threshold": 1.5,
    "detector_recovery_confirm": 2,
    "detector_reference_budget": 3.0,
    "detector_clip_factor": 2.0,
    "detector_weight_cap": 2.0,
    "suspicion_penalty_factor": 0.5,
    "suspicion_recovery_factor": 1.25,
    "suspicion_remove_after": 3,

    "compute_backend": "torch",
    "device": "cuda",

    "early_stop": false,
    "eval_interval": 1,
    "visualizations": true,
    "progress": true,
    "checkpoint_interval": 0,

    "methods": ["sm9rrs", "vert", "alignins", "krum", "ding13", "fedavg"]
  },

  "tuning": {
    "algorithm": "grid",

    "validation_fraction": 0.15,
    "split_seed": 20261013,
    "validation_seeds": [301, 302, 303],
    "final_seeds": [401, 402, 403],

    "trials_per_tunable_method": 12,

    "run_final_evaluation": true,
    "final_jobs": "auto",

    "max_clean_accuracy_drop": 0.05,

    "performance_target": {
      "accuracy_gap": 0.02,
      "asr_gap": 0.01,
      "max_asr": 0.08,
      "max_peak_asr": 0.20,
      "tail_rounds": 10
    },

    "objective": "auto",

    "method_spaces": {
      "sm9rrs": {
        "detector_distance_threshold": [2.0, 2.1, 2.2, 2.3, 2.4, 2.5, 2.6, 2.7, 2.8, 2.9, 3.0, 3.1]
      },

      "vert": {
        "vert_history_window": [5, 10, 15],
        "vert_projection_dim": [20],
        "vert_predict_epochs": [5, 10],
        "vert_predict_lr": [0.01, 0.001],
        "vert_top_k": [5],
        "vert_use_ratio_prior": [false]
      },

      "alignins": {
        "alignins_sparsity": [0.8, 0.85, 0.9, 0.95],
        "alignins_tda_radius": [0.05, 0.1, 0.2],
        "alignins_mpsa_radius": [0.1]
      },

      "krum": {},
      "ding13": {},
      "fedavg": {}
    }
  }
}
