{
  "schema_version": 3,
  "name": "CIFAR-10 TPE Tuning - sm9rrs Only (Quick)",
  "description": "Fast hyperparameter optimization for sm9rrs only to beat AlignIns",
  "tuning": {
    "enabled": true,
    "framework": "optuna",
    "sampler": "TPESampler",
    "trials_per_method": 40,
    "calibration_ratios": [0.2, 0.4],
    "calibration_partitions": ["iid", "dirichlet"],
    "calibration_rounds": 30,
    "validation_rounds": 50,
    "selection_metrics": {
      "primary": "attack_success_rate",
      "secondary": "accuracy_drop",
      "weights": {"asr": 0.7, "accuracy": 0.2, "stability": 0.1}
    }
  },
  "parameters": {
    "dataset": "cifar10",
    "data_dir": "data/cifar10",
    "output_dir": "outputs/cifar10_v10_sm9rrs_focused_tpe",
    "methods": ["sm9rrs"],
    "ratios": [0.2, 0.4],
    "partitions": ["iid", "dirichlet"],
    "dirichlet_alpha": 0.5,
    "num_clients": 100,
    "rounds": 30,
    "local_epochs": 1,
    "batch_size": 50,
    "lr": 0.05,
    "lr_decay": 0.99,
    "attack": "alternating_minimization",
    "attack_boost": {"type": "suggest_float", "low": 18.0, "high": 28.0, "step": 1.0},
    "attack_epochs": 1,
    "attack_source_label": 5,
    "attack_target_label": 7,
    "attack_target_count": 200,
    "attack_start_round": 12,
    "detector_window": 10,
    "detector_subspace_dim": {"type": "suggest_int", "low": 3, "high": 5},
    "detector_normal_clusters": 2,
    "detector_distance_threshold": {"type": "suggest_float", "low": 1.5, "high": 2.5, "step": 0.1},
    "detector_reject_threshold": {"type": "suggest_float", "low": 3.5, "high": 5.0, "step": 0.25},
    "detector_drift_memory": {"type": "suggest_float", "low": 0.85, "high": 0.95, "step": 0.02},
    "detector_drift_allowance": {"type": "suggest_float", "low": 2.0, "high": 3.0, "step": 0.2},
    "detector_drift_threshold": {"type": "suggest_float", "low": 5.0, "high": 7.0, "step": 0.5},
    "detector_history_confirm": {"type": "suggest_int", "low": 2, "high": 3},
    "detector_history_threshold": {"type": "suggest_float", "low": 1.4, "high": 1.8, "step": 0.1},
    "detector_recovery_confirm": 2,
    "detector_reference_budget": {"type": "suggest_float", "low": 2.5, "high": 3.5, "step": 0.25},
    "detector_clip_factor": {"type": "suggest_float", "low": 1.8, "high": 2.5, "step": 0.1},
    "detector_weight_cap": {"type": "suggest_float", "low": 1.8, "high": 2.5, "step": 0.1},
    "suspicion_penalty_factor": {"type": "suggest_float", "low": 0.4, "high": 0.6, "step": 0.05},
    "suspicion_recovery_factor": 1.25,
    "suspicion_remove_after": 3,
    "crypto_mode": "simulated",
    "compute_backend": "torch",
    "device": "cuda",
    "early_stop": false,
    "eval_interval": 1,
    "seed": 2026101303
  }
}
